{
  "name": "fluid-platinum-ui",
  "version": "1.0.1",
  "description": "A futuristic glassmorphic design system built with pure HTML & CSS",
  "main": "dist/index.css",
  "style": "dist/index.css",
  "files": [
    "dist/",
    "index.css",
    "tokens/",
    "base/",
    "components/",
    "utilities/",
    "components/modal/modal.js",
    "LICENSE"
  ],
  "scripts": {
    "build": "postcss index.css -o dist/index.css",
    "prebuild": "mkdir -p dist",
    "lint": "stylelint '**/*.css' --ignore-path .gitignore",
    "lint:fix": "stylelint '**/*.css' --fix --ignore-path .gitignore",
    "audit:a11y": "pa11y preview.html",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "css",
    "design-system",
    "glassmorphism",
    "dark-mode",
    "accessible",
    "no-javascript"
  ],
  "license": "MIT",
  "browserslist": [
    "Chrome >= 76",
    "Firefox >= 103",
    "Safari >= 15.4",
    "Edge >= 79",
    "iOS >= 15.4"
  ],
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "cssnano": "^7.1.3",
    "pa11y": "^8.0.0",
    "postcss": "^8.5.8",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^37.0.0"
  }
}
